# Public, client-safe config — same values already shipped in bluvfi's web
# client bundle (NEXT_PUBLIC_* there, EXPO_PUBLIC_* here). No secrets here;
# server-side keys (Circle, banking providers, OpenAI, Privy app secret) stay
# in bluvfi's Next.js server and are never exposed to this app.

EXPO_PUBLIC_API_BASE_URL=https://www.bluvfi.xyz

EXPO_PUBLIC_PRIVY_APP_ID=cm56ok03n07cqzb2qbbjm7rv2
# Required for @privy-io/expo and not present in bluvfi's web env (the web
# SDK doesn't need it). Create one at https://dashboard.privy.io under your
# app's Settings -> Clients -> "+ New client" -> React Native/Expo, then
# paste the client ID below.
EXPO_PUBLIC_PRIVY_CLIENT_ID=client-WY5fCB44YKzoaFb6U56Vd6KdqDHrv9EPR3E9EWHJAqcK3

# Alchemy key for EVM balances (create a free one at https://dashboard.alchemy.com). Balances stay empty without it.
EXPO_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_vmBCCIZpaSbqCFwruvmSjbpaWFM
# No iOS key exists anywhere in bluvfi yet (web only ships Android). Get one
# from RevenueCat dashboard -> Project settings -> API keys -> App Store.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Bill-pay Solana receiver — not configured on bluvfi web either (same env var
# name pattern, EXPO_PUBLIC_ vs NEXT_PUBLIC_); Solana bill payments are a
# no-op until this is set, matching web's current behavior exactly.
EXPO_PUBLIC_SOLANA_BILL_RECEIVER=

# ── Optional ──────────────────────────────────────────────────────────────
# Sign-In With Solana domain and URI (default to the production site).
# EXPO_PUBLIC_SIWS_DOMAIN=www.bluvfi.xyz
# EXPO_PUBLIC_SIWS_URI=https://www.bluvfi.xyz
# Direct Solana RPC used by the Seeker and .skr reads only when the backend's RPC proxy is unavailable.
# Unset: Alchemy if the key above is set, else the public endpoint.
# EXPO_PUBLIC_SOLANA_RPC_URL=
# Development builds only: behave as a Solana Seeker on an emulator, to preview the Seeker-only screens.
# EXPO_PUBLIC_FORCE_SEEKER=1
